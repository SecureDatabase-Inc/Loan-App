# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL via docker-compose)
DATABASE_URL="postgresql://postgres:password@localhost:5432/micro_loan_db"

# Auth (REQUIRED - change in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Session cookie TTL in days (default 7)
SESSION_TTL_DAYS=7
ADMIN_JWT_EXPIRES_IN=1d

# Client
CLIENT_URL="http://localhost:3000"

# Admin
ADMIN_EMAIL=admin@boamicrofinance.com

# Email (SMTP)
EMAIL_FROM="BoA Micro Finance <noreply@boamicrofinance.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Identity document storage
# disabled   - rejects uploads with a clear error (default when Cloudinary vars are absent)
# test       - deterministic in-process storage for automated tests (no network)
# cloudinary - private Cloudinary delivery (requires the three variables below)
# If unset, the server enables cloudinary only when all three Cloudinary variables are present.
KYC_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max verification uploads per user per 15 minutes (default 10)
UPLOAD_LIMIT_MAX=10

# Payments (mobile money gateway)
# mock  - auto-confirms payments locally, no gateway required (default)
# flutterwave - Ghana Mobile Money via Flutterwave (requires keys below)
PAYMENT_PROVIDER=mock
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=