# Web development
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Capacitor (Android) builds — set before `npm run build:android:*`
# NEXT_PUBLIC_APP_TARGET=capacitor
# NEXT_PUBLIC_BUILD_FLAVOR=debug
# NEXT_PUBLIC_API_URL=https://api.example.com/api
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com
# ALLOWED_ORIGINS on the server must include the Capacitor origins (see docs).
